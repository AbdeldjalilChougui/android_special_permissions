<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Package visibility (Android 11+): let resolveActivity() see the Settings
      screens this plugin opens. No permission is declared here; the app
      declares the ones it actually uses.
    -->
    <queries>
        <intent><action android:name="android.settings.USAGE_ACCESS_SETTINGS" /></intent>
        <intent><action android:name="android.settings.USAGE_ACCESS_SETTINGS" /><data android:scheme="package" /></intent>
        <intent><action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" /></intent>
        <intent><action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" /><data android:scheme="package" /></intent>
        <intent><action android:name="android.settings.ACCESSIBILITY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.ACCESSIBILITY_DETAILS_SETTINGS" /></intent>
        <intent><action android:name="android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS" /></intent>
        <intent><action android:name="android.settings.NOTIFICATION_LISTENER_DETAIL_SETTINGS" /></intent>
        <intent><action android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" /><data android:scheme="package" /></intent>
        <intent><action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS" /></intent>
        <intent><action android:name="android.settings.REQUEST_SCHEDULE_EXACT_ALARM" /></intent>
        <intent><action android:name="android.settings.REQUEST_SCHEDULE_EXACT_ALARM" /><data android:scheme="package" /></intent>
        <intent><action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" /></intent>
        <intent><action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" /><data android:scheme="package" /></intent>
        <intent><action android:name="android.settings.MANAGE_ALL_FILES_ACCESS_PERMISSION" /></intent>
        <intent><action android:name="android.settings.MANAGE_APP_ALL_FILES_ACCESS_PERMISSION" /><data android:scheme="package" /></intent>
        <intent><action android:name="android.settings.action.MANAGE_WRITE_SETTINGS" /></intent>
        <intent><action android:name="android.settings.action.MANAGE_WRITE_SETTINGS" /><data android:scheme="package" /></intent>
        <intent><action android:name="android.settings.NOTIFICATION_POLICY_ACCESS_SETTINGS" /></intent>
        <intent><action android:name="android.settings.MANAGE_APP_USE_FULL_SCREEN_INTENT" /><data android:scheme="package" /></intent>
        <intent><action android:name="android.settings.APP_NOTIFICATION_SETTINGS" /></intent>
        <intent><action android:name="android.settings.PICTURE_IN_PICTURE_SETTINGS" /></intent>
        <intent><action android:name="android.settings.PICTURE_IN_PICTURE_SETTINGS" /><data android:scheme="package" /></intent>
        <intent><action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" /><data android:scheme="package" /></intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
    </queries>
</manifest>
